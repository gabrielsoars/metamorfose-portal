POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# development | homologacao | producao
APP_ENV=development

# JWT (RS256): as chaves ficam em ./keys (ver README). Os valores abaixo
# são compartilhados pelo monolito e pelo scan_service e precisam ser iguais.
JWT_ALGORITHM=RS256
JWT_ISSUER=metamorfose-monolito
JWT_AUDIENCE=metamorfose-scan-service
JWT_EXPIRE_MINUTES=60

# E-mail do código de primeiro acesso. Sem SMTP_HOST, em development
# o código é exibido no log do monolito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@metamorfose.local

# Admin inicial: criado ao subir o monolito se ainda não existir nenhum admin.
# Ele recebe o código de primeiro acesso por e-mail e define a própria senha.
ADMIN_EMAIL=
ADMIN_NOME=Administrador
